# ===========================================
# CAMPUS ECHO - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in values

# ------------------------------------------
# DATABASE
# ------------------------------------------
# PostgreSQL connection string
# For NeonDB: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# For Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/campus_echo"

# ------------------------------------------
# NEXTAUTH / AUTH.JS
# ------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------
# GOOGLE OAUTH (for social login)
# ------------------------------------------
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ------------------------------------------
# CLOUDINARY (file uploads)
# ------------------------------------------
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------
# EMAIL (for verification, password reset)
# ------------------------------------------
# Option 1: Resend (recommended)
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="Campus Echo <noreply@campusecho.app>"

# Option 2: SMTP (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"

# ------------------------------------------
# PUSHER (real-time notifications)
# ------------------------------------------
# Get from: https://pusher.com/dashboard
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_APP_KEY="your-pusher-key"
PUSHER_APP_SECRET="your-pusher-secret"
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ------------------------------------------
# APP CONFIGURATION
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Campus Echo"

# ------------------------------------------
# SECURITY
# ------------------------------------------
# Encryption key for sensitive data (32 chars)
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# Rate limiting
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# ------------------------------------------
# FEATURE FLAGS
# ------------------------------------------
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="true"
NEXT_PUBLIC_ENABLE_FILE_UPLOADS="true"
NEXT_PUBLIC_ENABLE_REALTIME="true"
NEXT_PUBLIC_MAINTENANCE_MODE="false"
